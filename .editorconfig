root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# detekt's MaxLineLength default, so the two linters agree.
max_line_length = 120
# Composables are named like classes (Compose's API guidelines); detekt.yml says the same for detekt.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Copies of the dashboard's SVGs, byte for byte as its generator writes them (D38).
[icons/weather/**.svg]
insert_final_newline = false

# Copies of Google's Material Symbols and their licence, byte for byte as Google publishes them (D48).
[icons/symbols/{*.svg,LICENSE}]
insert_final_newline = false

[*.{yml,yaml,toml}]
indent_size = 2
