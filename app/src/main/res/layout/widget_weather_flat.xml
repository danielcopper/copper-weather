<?xml version="1.0" encoding="utf-8"?>
<!-- The widget "Wetter" one row high, the flat bucket (D11, D36): "now" as
     the dashboard's today (its still image at the left, and beside it the
     temperature over the rain hint or the condition, or "Neu anmelden" in
     that line's place while the sign-in is no longer usable, and today's
     high, low and rain below them), and beside it,
     after a divider, as many of the next days as fit (D41), or a plain text
     instead, on the card. Every part starts hidden; WidgetViews shows the
     ones it fills, adds the days, and sets the colours from the palette,
     light and dark (D7). Every part takes its looks from styles.xml, as in
     widget_weather.xml, "Neu anmelden" and the plain text but for their
     heights; without days WidgetViews widens "now" to the card. The whole
     card is one tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    style="@style/WeatherWidget.FlatCard">

    <LinearLayout
        android:id="@+id/now_column"
        style="@style/WeatherWidget.FlatNow"
        android:visibility="gone">

        <ImageView
            android:id="@+id/now_icon"
            style="@style/WeatherWidget.FlatNowIcon"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/now_text"
            style="@style/WeatherWidget.FlatNowText">

            <TextView
                android:id="@+id/now_temperature"
                style="@style/WeatherWidget.FlatTemperature"
                android:visibility="gone" />

            <TextView
                android:id="@+id/now_line"
                style="@style/WeatherWidget.Line.Flat"
                android:visibility="gone" />

            <TextView
                android:id="@+id/now_line_long"
                style="@style/WeatherWidget.Line.Long.Flat"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_notice"
                style="@style/WeatherWidget.Notice.Flat"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/now_today_flat"
                style="@style/WeatherWidget.FlatToday"
                android:visibility="gone">

                <TextView
                    android:id="@+id/now_today_flat_high"
                    style="@style/WeatherWidget.FlatToday.Degree.High" />

                <TextView
                    android:id="@+id/now_today_flat_low"
                    style="@style/WeatherWidget.FlatToday.Degree.Low" />

                <TextView
                    android:id="@+id/now_today_flat_rain"
                    style="@style/WeatherWidget.FlatToday.Degree.Rain"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/divider"
        style="@style/WeatherWidget.FlatDivider"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/days"
        style="@style/WeatherWidget.FlatDays"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_plain"
        style="@style/WeatherWidget.Plain"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
