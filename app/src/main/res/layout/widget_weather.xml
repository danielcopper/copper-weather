<?xml version="1.0" encoding="utf-8"?>
<!-- The widget "Wetter" (D12-D14, D33, D36): the warning band across the
     top while a warning applies, in the wide and tall buckets (D47); "now"
     (its image, still or animated in the frame beside it (D43, D44), the
     temperature, today's high and low beside it or, in the small bucket,
     below it, where "Stand 14:30" takes their place there (D16), then the
     rain hint or the condition, or in the small bucket a warning's short
     form in their place, and the notice line with "Neu anmelden" while the
     sign-in is no longer usable and, in the wide and tall buckets, "Stand
     14:30"), the hours and the days as the size bucket shows them, or a
     plain text instead, below the band or the short form while a warning
     applies (D18), on the card. Every part starts hidden; WidgetViews
     shows the ones it fills, adds the hours and days, and sets the texts'
     colours from the palette, light and dark (D7). The card, "now" and the
     hours' strip take their looks from styles.xml, as the picker's preview
     does, and so do "Neu anmelden" and the plain text but for their heights;
     the days' list carries its own. The whole card is one tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    style="@style/WeatherWidget.Card">

    <LinearLayout
        android:id="@+id/band"
        style="@style/WeatherWidget.Band"
        android:visibility="gone">

        <TextView
            android:id="@+id/band_word"
            style="@style/WeatherWidget.BandWord"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/band_symbol"
            style="@style/WeatherWidget.BandSymbol"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/band_text"
            style="@style/WeatherWidget.BandText" />

        <TextView
            android:id="@+id/band_more"
            style="@style/WeatherWidget.BandMore" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/now"
        style="@style/WeatherWidget.NowRow"
        android:visibility="gone">

        <ImageView
            android:id="@+id/now_icon"
            style="@style/WeatherWidget.NowIcon"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:id="@+id/now_icon_animated"
            style="@style/WeatherWidget.NowIcon"
            android:visibility="gone" />

        <TextView
            android:id="@+id/now_temperature"
            style="@style/WeatherWidget.NowTemperature"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/now_today"
            style="@style/WeatherWidget.NowToday"
            android:visibility="gone">

            <TextView
                android:id="@+id/now_high"
                style="@style/WeatherWidget.Degrees" />

            <TextView
                android:id="@+id/now_low"
                style="@style/WeatherWidget.Degrees" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/now_today_below"
        style="@style/WeatherWidget.NowTodayBelow"
        android:visibility="gone">

        <TextView
            android:id="@+id/now_high_below"
            style="@style/WeatherWidget.Degrees.Below" />

        <TextView
            android:id="@+id/now_low_below"
            style="@style/WeatherWidget.Degrees" />
    </LinearLayout>

    <TextView
        android:id="@+id/stale"
        style="@style/WeatherWidget.Stale"
        android:visibility="gone" />

    <TextView
        android:id="@+id/now_line"
        style="@style/WeatherWidget.Line"
        android:visibility="gone" />

    <TextView
        android:id="@+id/now_line_long"
        style="@style/WeatherWidget.Line.Long"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/short_form"
        style="@style/WeatherWidget.ShortSlot"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/short_pill"
            style="@style/WeatherWidget.Short">

            <TextView
                android:id="@+id/short_word"
                style="@style/WeatherWidget.ShortWord" />

            <ImageView
                android:id="@+id/short_alert"
                style="@style/WeatherWidget.ShortAlert"
                android:importantForAccessibility="no"
                android:src="@drawable/symbol_other"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/short_symbol"
                style="@style/WeatherWidget.ShortSymbol"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/short_more"
                style="@style/WeatherWidget.ShortMore" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notice_row"
        style="@style/WeatherWidget.NoticeRow"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_notice"
            style="@style/WeatherWidget.Notice.InRow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notice_stale"
            style="@style/WeatherWidget.Notice.Stale"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hours"
        style="@style/WeatherWidget.Hours"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_plain"
        style="@style/WeatherWidget.Plain"
        android:layout_height="match_parent"
        android:visibility="gone" />
</LinearLayout>
