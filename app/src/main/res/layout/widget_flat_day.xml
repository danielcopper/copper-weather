<?xml version="1.0" encoding="utf-8"?>
<!-- A day of the flat bucket (D41): its weekday, its still image and its
     high and low; WidgetRows fills it and sets the pair's size, and
     WidgetViews adds as many as fit the width. Its looks are styles.xml's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WeatherWidget.FlatDay">

    <TextView
        android:id="@+id/flat_day_weekday"
        style="@style/WeatherWidget.FlatDaySmall" />

    <ImageView
        android:id="@+id/flat_day_icon"
        style="@style/WeatherWidget.FlatDayIcon"
        android:importantForAccessibility="no" />

    <LinearLayout style="@style/WeatherWidget.FlatDayDegrees">

        <TextView
            android:id="@+id/flat_day_high"
            style="@style/WeatherWidget.FlatDayDegree.High" />

        <TextView
            android:id="@+id/flat_day_low"
            style="@style/WeatherWidget.FlatDayDegree.Low" />
    </LinearLayout>
</LinearLayout>
