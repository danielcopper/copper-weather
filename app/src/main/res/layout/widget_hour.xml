<?xml version="1.0" encoding="utf-8"?>
<!-- An hour of the hours (D13): its time, its still image (the night form at
     night), its temperature and its rain when it has; WidgetViews fills it
     and adds as many as fit the width, each an equal share of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="@dimen/widget_hour_height"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/hour_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/hour_icon"
        android:layout_width="@dimen/widget_small_icon"
        android:layout_height="@dimen/widget_small_icon"
        android:layout_marginVertical="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/hour_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/hour_rain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
