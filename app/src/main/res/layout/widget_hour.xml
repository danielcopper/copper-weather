<?xml version="1.0" encoding="utf-8"?>
<!-- An hour of the hours (D13): its time, its still image (the night form at
     night), its temperature and its rain when it has; WidgetRows fills it,
     and WidgetViews adds as many as fit the width, each an equal share of it. Its looks
     are styles.xml's, which the picker's preview shares. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/WeatherWidget.Hour">

    <TextView
        android:id="@+id/hour_time"
        style="@style/WeatherWidget.HourTime" />

    <ImageView
        android:id="@+id/hour_icon"
        style="@style/WeatherWidget.HourIcon"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/hour_temperature"
        style="@style/WeatherWidget.HourTemperature" />

    <TextView
        android:id="@+id/hour_rain"
        style="@style/WeatherWidget.HourRain"
        android:visibility="gone" />
</LinearLayout>
