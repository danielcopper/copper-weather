<?xml version="1.0" encoding="utf-8"?>
<!-- A tile's ground in the short form in the flat and small buckets (D47),
     with rounded corners: its colour is a placeholder, as the widget tints
     it in its warnings' level's colour at 16 % (WarningViews.kt), light and
     dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/palette_text" />
    <corners android:radius="4dp" />
</shape>
