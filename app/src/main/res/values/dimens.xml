<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's parts (widget_weather.xml, widget_weather_flat.xml,
     widget_hour.xml, widget_day.xml, widget_flat_day.xml) at fixed sizes,
     so WidgetViews can work out how many hours fit the width and how many
     days the height, or in the flat bucket the width (D35). -->
<resources>
    <dimen name="widget_padding">12dp</dimen>
    <dimen name="widget_gap">8dp</dimen>
    <!-- "Now": the row of its image, temperature and today's high and low, the
         line below it, and "Neu anmelden" below that while it shows; the gap
         between the image and the temperature, in every bucket. -->
    <dimen name="widget_now_height">48dp</dimen>
    <dimen name="widget_now_icon">48dp</dimen>
    <dimen name="widget_now_temperature_text">30sp</dimen>
    <dimen name="widget_now_gap">6dp</dimen>
    <!-- "Now" in the small bucket (D36): a lower row with a smaller image. -->
    <dimen name="widget_now_height_compact">40dp</dimen>
    <dimen name="widget_now_icon_compact">40dp</dimen>
    <!-- Today's high and low in a row below "now", in the small bucket. -->
    <dimen name="widget_today_height">18dp</dimen>
    <!-- The flat bucket (D36): "now" in a column of its own width, its image
         at the left and its temperature and line beside it, then a line as
         the dashboard's divider and its padding, and the days beside it, each
         at least as wide as the dashboard's day cell, with its gap; the
         card's padding above and below is less than its sides', so a day fits
         one row. -->
    <dimen name="widget_flat_now_width">126dp</dimen>
    <dimen name="widget_flat_now_icon">56dp</dimen>
    <dimen name="widget_flat_temperature_text">24sp</dimen>
    <dimen name="widget_flat_temperature_height">30dp</dimen>
    <!-- Today's high, low and rain, a third line below "now"; the rain shrinks
         to its least size and leaves out what does not fit then (D36). -->
    <dimen name="widget_flat_today_height">16dp</dimen>
    <dimen name="widget_flat_today_text">11sp</dimen>
    <dimen name="widget_flat_today_text_least">7sp</dimen>
    <dimen name="widget_flat_today_low_gap">3dp</dimen>
    <dimen name="widget_flat_today_rain_gap">4dp</dimen>
    <dimen name="widget_flat_padding">8dp</dimen>
    <dimen name="widget_divider">1dp</dimen>
    <!-- 12 dp from the divider to the first day: the days' own 8 and that
         day's gap of 4 (D41). -->
    <dimen name="widget_flat_days_padding">8dp</dimen>
    <dimen name="widget_flat_day_width">40dp</dimen>
    <dimen name="widget_flat_day_gap">4dp</dimen>
    <!-- The line below "now" and its two-line form: D36. -->
    <dimen name="widget_line_text">14sp</dimen>
    <dimen name="widget_line_height">20dp</dimen>
    <dimen name="widget_line_long_text">12sp</dimen>
    <dimen name="widget_line_long_height">36dp</dimen>
    <dimen name="widget_line_flat_text">13sp</dimen>
    <dimen name="widget_line_long_flat_text">11sp</dimen>
    <dimen name="widget_line_long_flat_height">32dp</dimen>
    <!-- A flat day's high and low and the line below them (D41). -->
    <dimen name="widget_flat_day_degrees_height">18dp</dimen>
    <dimen name="widget_flat_day_note_height">16dp</dimen>
    <dimen name="widget_flat_day_text_least">6.5sp</dimen>
    <dimen name="widget_notice_height">18dp</dimen>
    <dimen name="widget_notice_text">13sp</dimen>
    <!-- An hour of the hours: its least width and its height. -->
    <dimen name="widget_hour_width">48dp</dimen>
    <dimen name="widget_hour_height">76dp</dimen>
    <!-- A day of the days. -->
    <dimen name="widget_day_height">28dp</dimen>
    <dimen name="widget_small_icon">24dp</dimen>
</resources>
